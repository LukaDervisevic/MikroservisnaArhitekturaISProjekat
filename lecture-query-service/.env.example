ENVIRONMENT=local

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

LECTURER_QUERY_SERVICE_PORT=

RABBITMQ_BROKER_URI=

# Saga chain: lecturer-service -> lecture-service -> lecture-query-service.
# Queue names must match rabbitmq/config/definitions_test.json.
# This service is the tail: it consumes sagas and replies to lecture-service.
RABBITMQ_LECTURE_TO_LECTURE_QUERY_QUEUE=lecture-query
RABBITMQ_REPLY_TO_LECTURE_QUEUE=reply-to-lecture
