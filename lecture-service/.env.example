ENVIRONMENT=local

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

LECTURE_SERVICE_PORT=

RABBITMQ_BROKER_URI=

# Saga chain: lecturer-service -> lecture-service -> lecture-query-service.
# Queue names must match rabbitmq/config/definitions_test.json.
# Inbound: sagas from lecturer-service, replies from lecture-query-service.
RABBITMQ_LECTURER_TO_LECTURE_QUEUE=lecturer-lecture
RABBITMQ_REPLY_TO_LECTURE_QUEUE=reply-to-lecture
# Outbound: sagas to lecture-query-service, replies to lecturer-service.
RABBITMQ_LECTURE_TO_LECTURE_QUERY_QUEUE=lecture-query
RABBITMQ_REPLY_TO_LECTURER_QUEUE=reply-to-lecturer
